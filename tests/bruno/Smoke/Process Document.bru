meta {
  name: Process Document
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/documents/process
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{idToken}}
}

body:json {
  {
    "documentId": "smoke-test-doc-1",
    "s3Key": "test-tenant/documents/smoke-test-doc-1.pdf",
    "documentType": 0
  }
}

tests {
  // s3Key above isn't a real object yet, so this won't return 200 until
  // one is uploaded to the document bucket — that's a separate step, not
  // part of this smoke test. What this DOES prove: the JWT authorizer
  // accepted the token, TenantMiddleware resolved custom:tenantId, and the
  // Lambda actually ran the handler — i.e. not an auth/routing failure.
  test("request is authenticated and reaches the handler", function () {
    expect(res.getStatus()).to.not.equal(401);
    expect(res.getStatus()).to.not.equal(403);
  });
}
